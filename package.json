{
  "name": "@takeokunn/metabase-mcp",
  "version": "0.1.3",
  "description": "MCP server for Metabase integration",
  "keywords": [
    "metabase",
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ai",
    "analytics",
    "business-intelligence"
  ],
  "license": "MIT",
  "author": "takeokunn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takeokunn/metabase-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/takeokunn/metabase-mcp/issues"
  },
  "homepage": "https://github.com/takeokunn/metabase-mcp#readme",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "metabase-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "debug": "mcp-inspector node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@modelcontextprotocol/inspector": "^0.16.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
