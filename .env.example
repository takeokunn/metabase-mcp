# Metabase MCP Server Configuration
#
# METABASE_URL: Base URL of your Metabase instance
#   - Must use HTTPS (http://localhost allowed for development)
#   - Trailing slash is automatically removed
#   - Example: https://metabase.yourcompany.com
METABASE_URL=https://your-metabase.example.com

# METABASE_API_TOKEN: API key for authentication
#   - Generate at: Admin Panel → Settings → Authentication → API Keys
#   - Requires admin privileges to create
#   - Format: mb_xxxxxxxxxxxx
METABASE_API_TOKEN=mb_your_api_token_here
